<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error 404 — No encontrado</title>
    <style>
      :root {
        color-scheme: dark;
      }
      html,
      body {
        height: 100%;
        margin: 0;
      }
      body {
        background: #000;
        color: #fff;
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          "Segoe UI",
          Roboto,
          "Helvetica Neue",
          Arial;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .container {
        text-align: center;
        padding: 2rem;
      }
      h1 {
        font-size: 6rem;
        margin: 0 0 0.5rem;
        letter-spacing: -4px;
      }
      p {
        font-size: 1.25rem;
        margin: 0 0 1.25rem;
        color: #bbb;
      }
      a {
        display: inline-block;
        padding: 0.6rem 1rem;
        background: #111;
        color: #fff;
        border: 1px solid #222;
        border-radius: 6px;
        text-decoration: none;
      }
      a:hover {
        background: #222;
      }
      @media (max-width: 600px) {
        h1 {
          font-size: 3.5rem;
        }
      }
    </style>
  </head>
  <body>
    <main class="container" role="main">
      <h1>404</h1>
      <p>Error 404 — Página no encontrada.</p>
      <a href="/">Volver al inicio</a>
    </main>
  </body>
</html>
