---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { navItemsExercise } from "../utils/NavItems.ts";
import SectionContainer from "../components/SectionContainer.astro";
import { Code } from "astro:components";
import { directories, exerciseEntries, subDirectories } from "./api/create-exercise.ts";

// The page receives directory metadata and their direct child entries from the server.
// La página recibe del servidor los metadatos de las carpetas y sus elementos directos.
---

<Layout
  title="Ejercicios de programación resueltos - erickdev"
  description="Ejercicios resueltos de lógica de programación utilizando Java."
>
  <Header navItems={navItemsExercise} />
  <main class="scroll-m-20 w-full pt-16 pb-8 gap-10 flex flex-row">
    <nav class="flex flex-col gap-y-2 p-8 w-xs pt-28">
      <ul>
        {
          directories.map((directory) => (
            <li>
              <!-- Show the category name and then its direct children. -->
              <!-- Muestra el nombre de la categoría y luego sus elementos directos. -->
              {directory.name}
              <ul class="flex flex-col gap-y-2 pl-4">
                {exerciseEntries
                  .filter((entry) => entry.category === directory.name)
                  .map((entry) => (
                    <li>
                      <!-- Files become links; directories remain labels for now. -->
                      <!-- Los archivos se convierten en enlaces; las carpetas siguen como etiquetas. -->
                      {entry.type === "file" ? (
                        <a
                          href={`/exercise?path=${encodeURIComponent(entry.path)}`}
                        >
                          {entry.name}
                        </a>
                      ) : (
                        <span>{entry.name}
                        <ul class="flex flex-col gap-y-2 pl-4">
                          {
                            subDirectories
                              .filter((subDir) => subDir.category === entry.name)
                              .map((subDir) => (
                                <li>
                                  <a
                                    href={`/exercise?path=${encodeURIComponent(
                                      subDir.path
                                    )}`}
                                  >
                                    {subDir.name}
                                  </a>
                                </li>
                              ))
                          }
                        </ul>
                        </span>
                      )}
                    </li>
                  ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </nav>
    <SectionContainer class="pb-8 md:pb-16 gap-20 flex flex-col">
      <h2>Ejercicios de programación resueltos</h2>
      <p>hola</p>
      <!-- <Code code={decodedContent} lang={"java"} /> -->
    </SectionContainer>
  </main>
</Layout>
