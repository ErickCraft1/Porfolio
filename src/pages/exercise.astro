---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { navItemsExercise } from "../utils/NavItems.ts";
import SectionContainer from "../components/SectionContainer.astro";
import { Code } from "astro:components";
import NavExercise from "../components/exercises/NavExercise.astro";

// Import the function to fetch file content from the API
import { exerciseEntries, subDirectories } from "./api/create-exercise";
import { getFileContent } from "./api/get-exercise.ts";

const owner = "ErickCraft1";
const repo = "Practica_Java";

// Use the selected path or fall back to the first available exercise.
// Usa la ruta seleccionada o utiliza como alternativa el primer ejercicio disponible.
const selectedPath = Astro.url.searchParams.get("path");

const firstExercise =
  exerciseEntries.find((entry) => entry.type === "file") ??
  subDirectories.find((subDir) => subDir.type === "file");

const path = selectedPath ?? firstExercise?.path;

// Fetch the selected exercise content.
// Obtiene el contenido del ejercicio seleccionado.
const content = path ? await getFileContent(owner, repo, path) : "";

// The page receives directory metadata and their direct child entries from the server.
// La página recibe del servidor los metadatos de las carpetas y sus elementos directos.
---

<Layout
  title="Ejercicios de programación resueltos - erickdev"
  description="Ejercicios resueltos de lógica de programación utilizando Java."
>
  <Header navItems={navItemsExercise} />
  <main class="scroll-m-20 w-full pt-16 pb-8 gap-10 flex flex-row">
    <NavExercise />
    <SectionContainer class="pb-8 md:pb-16 gap-20 flex flex-col">
      <h2>Ejercicios de programación resueltos</h2>
      <!-- <p>{content}</p> -->
      <Code code={content} lang={"java"} />
    </SectionContainer>
  </main>
</Layout>
