---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Admin"
  description="Panel de administración para agregar ejercicios resueltos de lógica de programación utilizando Java."
>
  <form action="">
    <label for="language">Lenguaje:</label>
    <select id="language" name="language">
      <option value="java">Java</option>
      <option value="python">Python</option>
      <option value="javascript">JavaScript</option>
      <option value="sqlite">SQLite</option>
    </select>
    <br />
    <label for="title">Titulo:</label>
    <input type="text" id="title" name="title" />
    <br />
    <label for="subtitle">Subtitulo:</label>
    <input type="text" id="subtitle" name="subtitle" />
    <br />
    <label for="number">Numero:</label>
    <input type="number" id="number" name="number" />
    <br />
    <label for="complexity">Complejidad:</label>
    <select id="complexity" name="complexity">
      <option value="O(1)">O(1)</option>
      <option value="O(n)">O(n)</option>
      <option value="O(n^2)">O(n²)</option>
    </select>
    <br />
    <label for="coding">Código:</label>
    <textarea id="coding" name="coding"></textarea>
    <br />
    <label for="reflexion">Reflexión:</label>
    <textarea id="reflexion" name="reflexion"></textarea>
    <br />
    <button class="cursor-pointer" type="submit">Submit</button>
  </form>
</Layout>

<script>
  const doc = document;
  const form = doc.querySelector("form");
  const data = {
    language: "",
    title: "",
    subtitle: "",
    number: "",
    complexity: "",
    coding: "",
    reflexion: "",
  };
  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      data.language = form.language.value;
      data.title = (form.elements.namedItem("title") as HTMLInputElement).value;
      data.subtitle = form.subtitle.value;
      data.number = form.number.value;
      data.complexity = form.complexity.value;
      data.coding = form.coding.value;
      data.reflexion = form.reflexion.value;
      const md = `---
language: ${data.language}
title: ${data.title}
subtitle: ${data.subtitle}
number: ${data.number}
complexity: ${data.complexity}
---

## Código
${data.coding}

## Reflexión
${data.reflexion}
`;
      console.log(md);
    });
  }
</script>
